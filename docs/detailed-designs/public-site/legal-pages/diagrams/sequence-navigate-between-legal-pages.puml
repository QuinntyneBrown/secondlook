@startuml
title UML sequence behaviour — Move between legal pages from the footer
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "PrivacyPage or TermsPage" as page
  participant "Router" as router
end box
actor -> page : Select "Terms" or "Privacy" in the footer
page -> router : Navigate to /terms or /privacy
router -> router : Match the public route, no authentication guard
router --> actor : Show the other legal page
@enduml

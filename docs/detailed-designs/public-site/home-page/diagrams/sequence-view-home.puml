@startuml
title UML sequence behaviour — View the home page
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "HomePage" as page
  participant "Router" as router
end box
actor -> router : Open "/"
router -> router : Match the public route, no authentication guard
router -> page : Activate HomePage
page -> page : Render hero heading and pricing line from bundled content (L2-001)
page -> page : Render "Three steps to a clear number" with 3 steps (L2-001)
page -> page : Render sample report with range and 5 findings (L2-001)
page -> page : Render header links and footer links (L2-001)
page --> actor : Show the home page
@enduml

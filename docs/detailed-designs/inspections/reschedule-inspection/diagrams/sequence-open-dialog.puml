@startuml
title UML sequence behaviour — Open the reschedule dialog
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor Buyer as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "InspectionDetailPage" as page
  participant "RescheduleDialog" as dialog
  participant "InspectionsApi" as client
end box
box "Backend — SecondLook.Api" #D1FADF
  participant "InspectionsController" as controller
end box
box "Backend — SecondLook.Application and Domain" #ECFDF3
  participant "GetRescheduleSlotsQueryHandler" as handler
end box
box "Backend — SecondLook.Infrastructure" #FFF4E5
  database "SecondLook database" as db
end box
actor -> page : Select "Reschedule"
page -> dialog : Open CDK Dialog
dialog -> client : Get slots for the chosen day
client -> controller : GET (HTTPS)
controller -> controller : Authenticate and scope to current buyer (L2-057)
controller -> handler : Send GetRescheduleSlotsQuery
handler -> db : Load availability of the assigned mechanic
db --> handler : Free and taken slots
handler --> controller : RescheduleSlotsView
controller --> client : Response
client --> dialog : Days and slots
dialog --> actor : "Pick a new time", "Dev Patel is free at these times. The seller gets a new text.", day choices, slots with unavailable slots disabled (L2-036)
@enduml

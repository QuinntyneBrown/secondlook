title Class structure — Reschedule an inspection

class GetRescheduleSlotsQuery {
  +Guid InspectionId
  +DateOnly Day
}
class GetRescheduleSlotsQueryHandler {
  +Handle(query: GetRescheduleSlotsQuery): Task<RescheduleSlotsView>
}
class RescheduleSlotsView {
  +string MechanicName
  +IReadOnlyList<DateOnly> Days
  +IReadOnlyList<SlotView> Slots
}
class SlotView {
  +Guid SlotId
  +DateTimeOffset Start
  +bool Available
}
class RescheduleInspectionCommand {
  +Guid InspectionId
  +Guid? NewSlotId
  +string IdempotencyKey
}
class RescheduleInspectionCommandValidator {
  +Validate(command): ValidationResult
}
class RescheduleInspectionCommandHandler {
  +Handle(command: RescheduleInspectionCommand): Task<RescheduleResult>
}
class RescheduleResult {
  +DateTimeOffset NewTime
  +DateTimeOffset PreviousTime
  +string SellerName
}
class UndoRescheduleCommand {
  +Guid InspectionId
}
class UndoRescheduleCommandHandler {
  +Handle(command: UndoRescheduleCommand): Task<Result>
}
class Inspection {
  +Guid Id

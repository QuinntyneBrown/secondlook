@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage saved vehicles

Person(buyer, "Buyer", "Manages vehicles")
System_Boundary(secondlook, "SecondLook") {
  Container(spa, "SecondLook app", "Angular", "Vehicle list screen and dialogs (TO SUPPLY)")
  Container(api, "SecondLook.Api", "ASP.NET Core", "Vehicle endpoints; Application and Domain logic")
  ContainerDb(db, "SecondLook database", "SQL Server", "Vehicles scoped by BuyerId")
}

Rel(buyer, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml

@startuml
title UML sequence behaviour — Conduct the review over video
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Body shop" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "Body shop review screen (TO SUPPLY)" as page
  participant "CallsApi" as client
end box
box "Backend — SecondLook.Api" #D1FADF
  participant "CallsController" as controller
end box
box "Backend — SecondLook.Application and Domain" #ECFDF3
  participant "Join call handler (TO SUPPLY)" as handler
end box
box "Backend — SecondLook.Infrastructure" #FFF4E5
  database "SecondLook database" as db
  participant "IVideoRoom adapter (vendor TO SUPPLY)" as room
end box
actor -> page : Open the assigned inspection
page -> client : Request room access
client -> controller : HTTPS request
controller -> controller : Authenticate, require role BodyShop
controller -> handler : Send join request
handler -> db : Load Inspection where BodyShopId is the caller
alt Inspection not assigned to this body shop
  db --> handler : Not found
  handler --> controller : NotFound result
  controller --> client : 404 ProblemDetails
  client --> page : Not available
  page --> actor : Show not available (copy TO SUPPLY)
else Assigned
  db --> handler : Inspection
  handler -> room : Issue access for the body shop (L2-062)
  room --> handler : Room access
  handler --> controller : Room access
  controller --> client : 200 response
  client --> page : Access granted
  page --> actor : Body shop reviews the vehicle over video (L2-062)
end
@enduml

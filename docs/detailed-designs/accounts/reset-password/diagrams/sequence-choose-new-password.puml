@startuml
title UML sequence behaviour — Choose a new password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Account holder" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "ResetPasswordPage" as page
  participant "AuthApi" as client
  participant "SessionStore" as session
end box
box "Backend — SecondLook.Api" #D1FADF
  participant "AuthController" as controller
end box
box "Backend — SecondLook.Application and Domain" #ECFDF3
  participant "CheckPasswordResetTokenQueryHandler" as checkh
  participant "ResetPasswordCommandHandler" as handler
  participant "PasswordResetToken" as token
  participant "User" as user
end box
box "Backend — SecondLook.Infrastructure" #FFF4E5
  participant "JwtTokenService" as tokens
  database "SecondLook database" as db
end box
actor -> page : Open the reset link
page -> client : checkPasswordResetToken(token)
client -> controller : GET token status (anonymous)
controller -> checkh : Send CheckPasswordResetTokenQuery
checkh -> db : Load token by hash
db --> checkh : Token or none
checkh -> token : Compare ExpiresAt with IClock (30 minutes, L2-011)
alt Token expired or unknown
  checkh --> page : Expired
  page --> actor : Alert "That link has expired" with "Send a new link" (L2-011)
else Token valid
  checkh --> page : Valid
  page --> actor : Form "Choose a new password" (L2-011)
  actor -> page : Submit new password and confirmation
  page -> page : Check length and match
  alt Invalid values, such as "short" and "shorter"
    page --> actor : Summary "Fix 2 things to save"; focus on summary (L2-011)
  else Valid and matching
    page -> page : Fields read-only; button "Saving" with aria-busy (L2-011)
    page -> client : resetPassword(request)
    client -> controller : POST reset-password (anonymous)
    controller -> handler : Send ResetPasswordCommand
    handler -> db : Load token and user
    handler -> user : Set hashed password
    handler -> token : Consume token
    handler -> db : Save changes in one unit of work
    handler -> tokens : Issue JWT
    tokens --> handler : Signed token
    handler --> controller : SignInResult
    controller --> client : 200 with token
    client --> page : Success
    page -> session : Store token and role
    page --> actor : Status "Password updated"; "Go to inspections" (L2-011)
  end
end
@enduml

@startuml
title UML sequence behaviour — Open one inspection as a mechanic or body shop
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Mechanic or body shop" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "Inspection screen" as page
  participant "Typed API client" as client
end box
box "Backend — SecondLook.Api" #D1FADF
  participant "InspectionsController" as controller
end box
box "Backend — SecondLook.Application and Domain" #ECFDF3
  participant "GetInspectionQueryHandler" as handler
  participant "AssignedScope" as scope
end box
box "Backend — SecondLook.Infrastructure" #FFF4E5
  database "SecondLook database" as db
end box
actor -> page : Open inspection by id
page -> client : Request inspection
client -> controller : HTTPS request with bearer token
controller -> controller : Authenticate caller
controller -> handler : Send GetInspectionQuery
handler -> db : Resolve Provider by current user id
db --> handler : Provider
handler -> scope : Apply L2-058 assigned scope
scope --> handler : Query restricted to the provider's assignments
handler -> db : Read inspection by id within scope
db --> handler : Row or none
alt inspection is assigned to the provider
  handler --> controller : Result with value
  controller --> client : HTTP 200 with the inspection
  client --> page : Inspection
  page --> actor : Present inspection
else inspection is assigned to someone else or does not exist
  handler --> controller : Result marked not visible (L2-058 criterion 2)
  controller --> client : Refusal status <TO SUPPLY> with no inspection data
  client --> page : Not-visible outcome
  page --> actor : Present refusal state <TO SUPPLY>
end
@enduml

@startuml
title UML sequence behaviour — List assigned inspections
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Mechanic or body shop" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "Inspections screen" as page
  participant "Typed API client" as client
end box
box "Backend — SecondLook.Api" #D1FADF
  participant "InspectionsController" as controller
end box
box "Backend — SecondLook.Application and Domain" #ECFDF3
  participant "ListInspectionsQueryHandler" as handler
  participant "AssignedScope" as scope
end box
box "Backend — SecondLook.Infrastructure" #FFF4E5
  database "SecondLook database" as db
end box
actor -> page : Open inspections list
page -> client : Request list
client -> controller : HTTPS request with bearer token
controller -> controller : Authenticate caller
controller -> handler : Send ListInspectionsQuery
handler -> db : Resolve Provider by current user id
db --> handler : Provider
handler -> scope : Apply L2-058 assigned scope for the provider
scope --> handler : Query restricted to MechanicId or BodyShopId = provider id
handler -> db : Read matching inspections
db --> handler : Assigned inspections only
handler --> controller : Assigned items
controller --> client : HTTP 200 with items
client --> page : Items
page --> actor : Present assigned inspections
@enduml

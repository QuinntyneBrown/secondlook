@startuml
title UML sequence behaviour — Request a page during maintenance
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "User" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "Page" as page
  participant "SystemErrorInterceptor" as interceptor
  participant "MaintenancePage" as maint
end box
box "Backend — SecondLook.Api" #D1FADF
  participant "Maintenance middleware" as mw
end box
actor -> page : Request a page
page -> interceptor : HTTP request
interceptor -> mw : Forward request
mw -> mw : Read maintenance state <TO SUPPLY>
mw --> interceptor : Status 503
interceptor -> maint : Navigate to /maintenance
maint --> actor : Show "Maintenance", "Back in about 20 minutes" with "We’re updating SecondLook. Inspections booked for tonight will go ahead; we’ll email if anything changes." (L2-060 criterion 4)
actor -> maint : Select "Check status"
maint --> actor : Check status target <TO SUPPLY>
@enduml

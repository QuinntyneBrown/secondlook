@startuml
title UML sequence behaviour — List own vehicles, inspections or estimates
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Buyer" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "Page (vehicles, inspections or estimates)" as page
  participant "Typed API client" as client
end box
box "Backend — SecondLook.Api" #D1FADF
  participant "Controller" as controller
end box
box "Backend — SecondLook.Application and Domain" #ECFDF3
  participant "ListInspectionsQueryHandler" as handler
  participant "BuyerScope" as scope
end box
box "Backend — SecondLook.Infrastructure" #FFF4E5
  database "SecondLook database" as db
end box
actor -> page : Open list
page -> client : Request list
client -> controller : HTTPS request with bearer token
controller -> controller : Authenticate caller
controller -> handler : Send ListInspectionsQuery
handler -> scope : Apply L2-057 buyer scope with current user id
scope --> handler : Query restricted to BuyerId = current user
handler -> db : Read matching rows
db --> handler : Own rows only
handler --> controller : Own items
controller --> client : HTTP 200 with items
client --> page : Items
page --> actor : Present own items
@enduml

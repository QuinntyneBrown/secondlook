@startuml
title UML sequence behaviour — Load available slots
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Buyer" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "BookSchedulePage" as page
  participant "BookingsApi" as client
end box
box "Backend — SecondLook.Api" #D1FADF
  participant "BookingsController" as controller
end box
box "Backend — SecondLook.Application and Domain" #ECFDF3
  participant "GetAvailableSlotsQueryHandler" as handler
end box
box "Backend — SecondLook.Infrastructure" #FFF4E5
  database "SecondLook database" as db
end box
actor -> page : Reach the Schedule step, or select a day
page --> actor : Show "Finding mechanics near Hamilton…", Continue disabled (L2-025)
page -> client : Request slots for the day
client -> controller : HTTPS request
controller -> controller : Authenticate, scope to current buyer
controller -> handler : Send GetAvailableSlotsQuery
handler -> db : Read slots, holds and assigned mechanic
alt Read fails
  db --> handler : Failure
  handler --> controller : Error result
  controller --> client : ProblemDetails
  client --> page : Error
  page --> actor : Show "We couldn’t load time slots" and "Try again" (L2-025)
else No slot free on the day
  db --> handler : No free slots, next day with openings
  handler --> controller : Empty result with next day
  controller --> client : 200 response
  client --> page : Empty
  page --> actor : Show "No mechanics free on Thursday" and "Show Friday" (L2-025)
else Slots exist
  db --> handler : Slots with taken flags
  handler --> controller : SlotView list
  controller --> client : 200 response
  client --> page : Slots
  page --> actor : Show slots, taken slots disabled (L2-025)
end
@enduml

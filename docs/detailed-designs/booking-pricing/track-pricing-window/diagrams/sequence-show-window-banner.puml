@startuml
title UML sequence behaviour — Show the pricing window banner
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Buyer" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "DashboardPage" as page
  participant "PricingWindowsApi" as client
  participant "WindowBanner" as banner
end box
box "Backend — SecondLook.Api" #D1FADF
  participant "PricingWindowsController" as controller
end box
box "Backend — SecondLook.Application and Domain" #ECFDF3
  participant "GetPricingWindowQueryHandler" as handler
  participant "PricingWindow" as window
end box
box "Backend — SecondLook.Infrastructure" #FFF4E5
  database "AppDbContext" as db
end box
actor -> page : Open /inspections
page -> client : getCurrent()
client -> controller : GET /api/pricing-windows/current
controller -> controller : Authenticate and scope to current buyer (L2-057)
controller -> handler : Send GetPricingWindowQuery
handler -> db : Load the buyer's window
db --> handler : PricingWindow
handler -> window : StateAt(now) using IClock
window --> handler : Open, Closing or Closed
handler --> controller : PricingWindowDto
controller --> client : 200 OK
client --> page : PricingWindowDto
page -> banner : Render state
alt More than two days remain
  banner --> actor : "Your window is open until Wed 4 Nov", "Add another car to compare for $25 each.", "Add another car · $25" (L2-034)
else Two days remain
  banner --> actor : "Your window closes in 2 days", "Add a car by Wed 4 Nov to keep the $25 price.", dismissible (L2-034)
  opt Buyer dismisses
    actor -> banner : Dismiss
    banner --> actor : Hide banner (persistence of dismissal is TO SUPPLY)
  end
else Window has closed
  banner --> actor : "Your window has closed", "A new inspection is $50 and starts a new window. Your reports stay in your account.", "Book an inspection"; not dismissible (L2-034)
end
@enduml

@startuml
title UML sequence behaviour — View billing history
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Buyer" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "BillingHistoryPage" as page
  participant "ReceiptsApi" as client
end box
box "Backend — SecondLook.Api" #D1FADF
  participant "ReceiptsController" as controller
end box
box "Backend — SecondLook.Application and Domain" #ECFDF3
  participant "GetBillingHistoryQueryHandler" as handler
end box
box "Backend — SecondLook.Infrastructure" #FFF4E5
  database "AppDbContext" as db
end box
actor -> page : Open /settings/billing
page -> page : Show busy placeholders (L2-031)
page -> client : getBillingHistory()
client -> controller : GET /api/receipts
controller -> controller : Authenticate and resolve current buyer (L2-057)
controller -> handler : Send GetBillingHistoryQuery
handler -> db : Load receipts and payments for the buyer
alt Load succeeds with receipts
  db --> handler : Receipts
  handler --> controller : ReceiptRowDto list
  controller --> client : 200 OK
  client --> page : Rows
  page --> actor : Show "Billing history", "Receipts for every inspection." and the table (L2-031)
else Load succeeds with no receipts
  db --> handler : No rows
  handler --> controller : Empty list
  controller --> client : 200 OK
  client --> page : Empty list
  page --> actor : Show "No receipts yet" and "Book an inspection" (L2-031)
else Load fails
  db --> handler : Error
  handler --> controller : Failure
  controller --> client : Error response
  client --> page : Error
  page --> actor : Show "Receipts didn’t load" and "Try again" (L2-031)
  actor -> page : Select "Try again"
  page -> client : getBillingHistory()
end
@enduml

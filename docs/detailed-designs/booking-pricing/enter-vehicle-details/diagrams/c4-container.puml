@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Enter vehicle details

Person(buyer, "Buyer", "Books an inspection")
System_Boundary(secondlook, "SecondLook") {
  Container(spa, "SecondLook app", "Angular", "Booking wizard, step Vehicle")
  Container(api, "SecondLook.Api", "ASP.NET Core", "Authenticated booking endpoints; Application and Domain logic")
  ContainerDb(db, "SecondLook database", "SQL Server", "Vehicles and draft bookings")
}
System_Ext(vin, "VIN lookup service", "Recognises a VIN (vendor <TO SUPPLY>)")

Rel(buyer, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, vin, "Looks up the VIN via", "HTTPS")
@enduml

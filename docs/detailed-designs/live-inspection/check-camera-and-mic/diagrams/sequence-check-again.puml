@startuml
title UML sequence behaviour — Check the camera again
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Buyer" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "CallLobbyPage" as page
  participant "MediaDevicesService" as media
end box
actor -> page : Select "Check again" (L2-040)
page -> media : Request the camera once more
media --> page : Granted or Denied
alt Camera granted
  page -> page : Clear the alert and enable the camera selector
  page --> actor : Show running preview labelled "You" and "Join the call"
else Camera still denied
  page --> actor : Keep the alert, "You · camera blocked" and "Join with audio only"
end
@enduml

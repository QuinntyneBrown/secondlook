@startuml
title UML sequence behaviour — Stay on the call
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Buyer" as actor
box "Frontend — SecondLook app (Angular)" #E0F2FE
  participant "LiveInspectionPage" as page
  participant "EndCallDialog" as dlg
end box
actor -> page : Select "End call"
page -> dlg : Open CDK Dialog
dlg --> actor : Ask "End the call for everyone?"; focus "Stay on the call" (L2-043)
actor -> dlg : Select "Stay on the call"
dlg -> page : Close without result
page --> actor : Return focus to "End call"; call continues
@enduml
